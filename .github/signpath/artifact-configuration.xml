<?xml version="1.0" encoding="utf-8"?>
<!-- What SignPath may sign for Tributary: only its own Windows files, for the version the build
     names. They're signed from the inside out, in three signing requests:
       1. the program and its uninstall window;
       2. the two installers that carry them (just for you, and for everyone on the PC);
       3. the setup people download, which carries the installers.
     Each request is a ZIP with a folder per architecture (x64, arm64) holding that round's
     files, so each file below is optional in any one request. -->
<artifact-configuration xmlns="http://signpath.io/artifact-configuration/v1">
  <parameters>
    <parameter name="version" required="true" />
  </parameters>
  <zip-file>
    <pe-file path="*/tributary.exe" min-matches="0" max-matches="2"
             product-name="Tributary" product-version="${version}" company-name="Bogdan Roatis">
      <authenticode-sign />
    </pe-file>
    <pe-file path="*/tributary-uninstall.exe" min-matches="0" max-matches="2"
             product-name="Tributary Setup" product-version="${version}" company-name="Bogdan Roatis">
      <authenticode-sign />
    </pe-file>
    <pe-file-set product-name="Tributary" product-version="${version}">
      <include path="*/just-me.exe" min-matches="0" max-matches="2" />
      <include path="*/everyone.exe" min-matches="0" max-matches="2" />
      <for-each>
        <authenticode-sign />
      </for-each>
    </pe-file-set>
    <pe-file path="*/Tributary_${version}_*-setup.exe" min-matches="0" max-matches="2"
             product-name="Tributary Setup" product-version="${version}" company-name="Bogdan Roatis">
      <authenticode-sign />
    </pe-file>
  </zip-file>
</artifact-configuration>
