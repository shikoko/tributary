{
  "$schema": "../gen/schemas/desktop-schema.json",
  "identifier": "default",
  "description": "Permissions for the main window: core APIs, window title, page zoom and the folder picker.",
  "windows": [
    "main"
  ],
  "permissions": [
    "core:default",
    "core:window:allow-set-title",
    "core:webview:allow-set-webview-zoom",
    "dialog:allow-open"
  ]
}
