{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "Tributary",
  "version": "0.2.0",
  "identifier": "io.github.shikoko.tributary",
  "build": {
    "beforeDevCommand": "npm run dev",
    "devUrl": "http://localhost:1420",
    "beforeBuildCommand": "npm run build",
    "frontendDist": "../dist"
  },
  "app": {
    "windows": [
      {
        "title": "Tributary",
        "visible": false,
        "width": 1280,
        "height": 800,
        "minWidth": 900,
        "minHeight": 560,
        "theme": "Dark",
        "backgroundColor": "#14161b",
        "titleBarStyle": "Overlay",
        "hiddenTitle": true,
        "trafficLightPosition": {
          "x": 14,
          "y": 18
        }
      }
    ],
    "security": {
      "csp": "default-src 'self'; img-src 'self' data: blob:; media-src 'self' data: blob:; style-src 'self' 'unsafe-inline'",
      "devCsp": null
    }
  },
  "bundle": {
    "active": true,
    "targets": "all",
    "category": "DeveloperTool",
    "copyright": "Copyright © 2026 Bogdan Roatis",
    "shortDescription": "A fast, friendly git client",
    "longDescription": "A fast, friendly git client: a commit graph that's easy to read, Undo for almost everything, pull requests in the app, and first-class Git LFS, locks and art diffs.",
    "macOS": {
      "dmg": {
        "background": "dmg/background.png",
        "windowSize": { "width": 660, "height": 420 },
        "appPosition": { "x": 180, "y": 196 },
        "applicationFolderPosition": { "x": 480, "y": 196 }
      }
    },
    "resources": {
      "../THIRD_PARTY_NOTICES.txt": "THIRD_PARTY_NOTICES.txt",
      "../LICENSE": "LICENSE"
    },
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ]
  },
  "plugins": {
    "updater": {
      "endpoints": ["https://github.com/shikoko/tributary/releases/latest/download/latest.json"],
      "pubkey": "dW50cnVzdGVkIGNvbW1lbnQ6IG1pbmlzaWduIHB1YmxpYyBrZXk6IDFENzg5M0JBODlDQTUyRjMKUldUelVzcUp1cE40SFVxUG81UTB1c25zZ05sOFlBem94b1p5Z2x2RHA2OWMyS2wwbWVOQUpITmYK",
      "windows": {
        "installMode": "passive"
      }
    }
  }
}
