{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "Tributary",
  "version": "0.1.0",
  "identifier": "io.github.shikoko.tributary",
  "build": {
    "beforeDevCommand": "npm run dev",
    "devUrl": "http://localhost:1420",
    "beforeBuildCommand": "npm run build",
    "frontendDist": "../dist"
  },
  "app": {
    "windows": [
      {
        "title": "Tributary",
        "width": 1280,
        "height": 800,
        "minWidth": 900,
        "minHeight": 560,
        "theme": "Dark",
        "backgroundColor": "#14161b",
        "titleBarStyle": "Overlay",
        "hiddenTitle": true,
        "trafficLightPosition": {
          "x": 14,
          "y": 18
        }
      }
    ],
    "security": {
      "csp": "default-src 'self'; img-src 'self' data: blob:; media-src 'self' data: blob:; style-src 'self' 'unsafe-inline'",
      "devCsp": null
    }
  },
  "bundle": {
    "active": true,
    "targets": "all",
    "category": "DeveloperTool",
    "shortDescription": "Git history graph viewer",
    "longDescription": "A fast, cross-platform viewer for the commit graph of a git repository.",
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ]
  },
  "plugins": {
    "updater": {
      "endpoints": ["https://github.com/shikoko/tributary/releases/latest/download/latest.json"],
      "pubkey": "dW50cnVzdGVkIGNvbW1lbnQ6IG1pbmlzaWduIHB1YmxpYyBrZXk6IDFENzg5M0JBODlDQTUyRjMKUldUelVzcUp1cE40SFVxUG81UTB1c25zZ05sOFlBem94b1p5Z2x2RHA2OWMyS2wwbWVOQUpITmYK",
      "windows": {
        "installMode": "passive"
      }
    }
  }
}
