{
  "name": "tributary",
  "private": true,
  "version": "0.2.0",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "tsc && vite build",
    "preview": "node tools/preview/server.mjs",
    "preview:build": "vite build && cargo build --manifest-path src-tauri/Cargo.toml --example headless",
    "preview:demo": "node tools/preview/demo.mjs --serve",
    "preview:smoke": "node tools/preview/smoke.mjs",
    "preview:screenshots": "node tools/preview/screenshots.mjs",
    "preview:catalogue": "node tools/preview/catalogue.mjs",
    "preview:clips": "node tools/preview/clips.mjs",
    "e2e": "node tools/e2e/run.mjs",
    "notices": "node tools/notices.mjs",
    "setup:build": "vite build --config src-tauri/setup/vite.config.mjs",
    "tauri": "tauri",
    "test": "vitest run",
    "lint": "eslint src"
  },
  "dependencies": {
    "@fontsource-variable/google-sans": "^5.3.2",
    "@fontsource-variable/jetbrains-mono": "^5.3.0",
    "@tauri-apps/api": "^2",
    "@tauri-apps/plugin-dialog": "^2",
    "@tauri-apps/plugin-notification": "^2",
    "@tauri-apps/plugin-opener": "^2",
    "highlight.js": "^11.12.0",
    "react": "^19.1.0",
    "react-dom": "^19.1.0",
    "three": "0.187.0"
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "@tauri-apps/cli": "^2",
    "@types/react": "^19.1.8",
    "@types/react-dom": "^19.1.6",
    "@types/three": "0.187.0",
    "@vitejs/plugin-react": "^6.3.0",
    "eslint": "^10.14.0",
    "eslint-plugin-react-hooks": "^7.1.1",
    "globals": "^17.14.0",
    "typescript": "~6.0.3",
    "typescript-eslint": "^8.72.2",
    "vite": "^8.3.7",
    "vitest": "^5.1.0"
  },
  "description": "A fast, friendly git client, with first-class Git LFS, locks and art diffs",
  "license": "MIT"
}
