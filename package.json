{
  "name": "tributary",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "tsc && vite build",
    "preview": "node tools/preview/server.mjs",
    "preview:build": "vite build && cargo build --manifest-path src-tauri/Cargo.toml --example headless",
    "preview:demo": "node tools/preview/demo.mjs --serve",
    "preview:smoke": "node tools/preview/smoke.mjs",
    "tauri": "tauri",
    "test": "vitest run"
  },
  "dependencies": {
    "@fontsource-variable/google-sans": "^5.3.2",
    "@fontsource-variable/jetbrains-mono": "^5.3.0",
    "@tauri-apps/api": "^2",
    "@tauri-apps/plugin-dialog": "^2",
    "@tauri-apps/plugin-notification": "^2",
    "@tauri-apps/plugin-opener": "^2",
    "react": "^19.1.0",
    "react-dom": "^19.1.0",
    "three": "0.186.1"
  },
  "devDependencies": {
    "@tauri-apps/cli": "^2",
    "@types/react": "^19.1.8",
    "@types/react-dom": "^19.1.6",
    "@types/three": "0.186.0",
    "@vitejs/plugin-react": "^6.0.2",
    "typescript": "~6.0.3",
    "vite": "^8.0.16",
    "vitest": "^3.2.7"
  },
  "description": "A fast, cross-platform git history graph viewer",
  "license": "MIT"
}
